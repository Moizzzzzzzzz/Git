# =====================================================================
# FabricQC 环境变量模板
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 标记【必填-生产】的项在生产环境必须配置；【需你提供】表示需要你从微信/腾讯云获取。
# =====================================================================

# ----- 通用 -----
NODE_ENV=development
TZ=Asia/Shanghai
API_PORT=3000
# 对外访问域名（Nginx 入口），用于 CORS 与 Cookie【必填-生产】
PUBLIC_BASE_URL=http://localhost:5173
# 允许跨域访问 API 的来源，逗号分隔（开发时为 Vite 地址）
CORS_ORIGINS=http://localhost:5173
# 布卷二维码链接前缀：二维码内容为 {QR_BASE_URL}/r/{二维码标识}【必填-生产】
QR_BASE_URL=https://qc.example.com

# ----- PostgreSQL -----
POSTGRES_USER=fabricqc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=fabricqc
# 开发：localhost；Docker 生产：主机名 postgres
DATABASE_URL=postgresql://fabricqc:change-me-strong-password@localhost:5432/fabricqc?schema=public
# 集成测试专用数据库（会被清空重建，切勿指向正式库）
TEST_DATABASE_URL=postgresql://fabricqc:change-me-strong-password@localhost:5432/fabricqc_test?schema=public

# ----- Redis / BullMQ -----
REDIS_URL=redis://localhost:6379
# 是否在 API 进程内运行 outbox 调度与通知 worker
RUN_WORKERS=true

# ----- 认证 -----
# 至少 32 位随机字符串：openssl rand -base64 48【必填-生产】
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 绑定码哈希 pepper，至少 16 位随机字符串【必填-生产】
BIND_CODE_PEPPER=
# 【开发默认值】绑定码有效期、最大错误次数
BIND_CODE_TTL_HOURS=24
BIND_CODE_MAX_ATTEMPTS=5
# 【开发默认值】PC 登录失败锁定策略
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 生产（HTTPS）必须为 true
COOKIE_SECURE=false

# ----- 微信小程序【需你提供】-----
WECHAT_APP_ID=
# AppSecret 只能配置在服务器端
WECHAT_APP_SECRET=
# 订阅消息模板 ID（公众平台 → 订阅消息 → 我的模板）
WECHAT_TPL_REVIEW_REQUEST=
WECHAT_TPL_REVIEW_RESULT=
# 模板字段映射：{"模板字段名":"业务字段"}，业务字段见 docs/OPERATIONS.md
WECHAT_TPL_REVIEW_REQUEST_FIELDS={"thing1":"rollNo","thing2":"fabricName","thing3":"inspectorName","phrase4":"overallResult","time5":"submittedAt"}
WECHAT_TPL_REVIEW_RESULT_FIELDS={"thing1":"rollNo","phrase2":"decision","thing3":"reviewerName","thing4":"comment","time5":"decidedAt"}
# 订阅消息跳转的小程序版本：developer / trial / formal
WECHAT_MINIPROGRAM_STATE=formal

# ----- 对象存储（S3 兼容：腾讯云 COS 或 MinIO）-----
STORAGE_PROVIDER=minio
# COS 示例：https://cos.ap-shanghai.myqcloud.com；开发 MinIO：http://localhost:9000
STORAGE_ENDPOINT=http://localhost:9000
# 生成给客户端的预签名 URL 使用的地址（真机调试 MinIO 时填电脑局域网 IP；COS 留空即同 ENDPOINT）
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=ap-shanghai
# COS 桶名格式：name-appid
STORAGE_BUCKET=fabricqc-dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# MinIO 为 true；COS 为 false（虚拟主机风格）
STORAGE_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=600
VIEW_URL_TTL_SECONDS=1800

# ----- 初始管理员（仅 db:seed 使用）-----
SEED_ADMIN_USERNAME=admin
# 至少 10 位且包含字母和数字
SEED_ADMIN_PASSWORD=
