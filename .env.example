# Local review example only. Replace placeholders with newly generated local values.
NODE_ENV=development
TZ=Asia/Shanghai
API_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
QR_BASE_URL=http://localhost:3000
POSTGRES_USER=fqc_local
POSTGRES_PASSWORD=local_example_password
POSTGRES_DB=fqc_local
DATABASE_URL=postgresql://fqc_local:local_example_password@localhost:5432/fqc_local
TEST_DATABASE_URL=postgresql://fqc_local:local_example_password@localhost:5432/fqc_test
REDIS_URL=redis://localhost:6379
RUN_WORKERS=false
JWT_ACCESS_SECRET=local_only_replace_with_random_secret_at_least_32_chars
BIND_CODE_PEPPER=local_only_replace_with_random_pepper_at_least_32_chars
COOKIE_SECURE=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=local-review-media
STORAGE_ACCESS_KEY_ID=local_example_access
STORAGE_SECRET_ACCESS_KEY=local_example_secret
STORAGE_FORCE_PATH_STYLE=true
SEED_ADMIN_USERNAME=local_admin
SEED_ADMIN_PASSWORD=local_example_password
