{
  "name": "@fabricqc/miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "FabricQC 微信小程序（Taro 4 + React）",
  "templateInfo": { "name": "default", "typescript": true, "css": "Sass", "framework": "React" },
  "scripts": {
    "build": "taro build --type weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "browserslist": ["last 3 versions", "Android >= 4.1", "ios >= 8"],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@fabricqc/quality-engine": "workspace:*",
    "@fabricqc/shared": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.23",
    "babel-preset-taro": "4.2.1",
    "postcss": "^8.5.4",
    "react-refresh": "^0.14.2",
    "sass": "^1.77.8",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0",
    "webpack": "5.91.0"
  }
}
