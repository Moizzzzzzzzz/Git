// FabricQC 数据模型
// 约定：UUID 主键；表名 snake_case（@@map）；列名 camelCase；所有时间为 timestamptz。
// 枚举值必须与 packages/shared/src/enums.ts 一致。

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 枚举 ============

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleCode {
  ADMIN
  INSPECTOR
  QC_SUPERVISOR
  QUALITY_MANAGER
  SALES
  BUSINESS_MANAGER
  BUSINESS_CLERK
}

enum ClientType {
  ADMIN_WEB
  MINIAPP
}

enum InspectionMode {
  MACHINE
  MANUAL
}

enum InspectionScope {
  FULL
  PARTIAL
  SAMPLING
}

enum RollStatus {
  PENDING
  ASSIGNED
  IN_INSPECTION
  SUBMITTED
  RETURNED
  PASSED
  FAILED
}

enum TaskOrigin {
  LEGACY
  BUSINESS
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskRollStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  RETURNED
  DONE
}

enum InspectionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  REJECTED
  VOIDED
}

enum JudgeResult {
  PASS
  FAIL
  INCONCLUSIVE
  NOT_APPLICABLE
}

enum StandardKind {
  FOUR_POINT
  CUSTOMER
}

enum StandardVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum DefectSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum ReviewDecision {
  APPROVE
  RETURN
  REJECT
}

enum AssignmentStatus {
  PENDING
  DONE
  CANCELLED
}

enum MediaStatus {
  PENDING
  UPLOADED
  FAILED
}

enum MediaKind {
  CHECKPOINT
  DEFECT
  GENERAL
}

enum OutboxStatus {
  PENDING
  ENQUEUED
  DONE
  FAILED
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

enum NotificationChannel {
  IN_APP
  WECHAT_SUBSCRIBE
  WECOM
}

// ============ 组织与身份 ============

model Department {
  vcansOrders VcansOrder[] @relation("VcansOrderDepartment")
  vcansImports VcansImportBatch[] @relation("VcansImportDepartment")
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users     User[]
  userRoles UserRole[]
  tasks     QcTask[]
  businessTasks QcTask[] @relation("TaskBusinessDepartment")

  @@map("departments")
}

model User {
  vcansMeasuredLengths VcansOrderRoll[] @relation("VcansMeasuredLengthActor")
  vcansMeasuredWeights VcansOrderRoll[] @relation("VcansMeasuredWeightActor")
  vcansAdditionalRequests VcansAdditionalRequest[] @relation("VcansAdditionalActor")
  vcansSupervised VcansOrder[] @relation("VcansSupervisor")
  vcansInspected VcansOrder[] @relation("VcansInspector")
  vcansOrdersCreated VcansOrder[] @relation("VcansOrderCreator")
  vcansArrivalConfirmations VcansOrder[] @relation("VcansArrivalConfirmer")
  vcansOrderConfirmations VcansOrder[] @relation("VcansOrderConfirmer")
  vcansImportsCreated VcansImportBatch[] @relation("VcansImportCreator")
  vcansChanges VcansOrderChange[] @relation("VcansChangeActor")
  vcansLotsCreated VcansDyeLot[] @relation("VcansLotCreator")
  vcansSelections VcansSampleSelection[] @relation("VcansSampleSelector")
  vcansReportsConfirmed VcansReportVersion[] @relation("VcansReportConfirmer")
  id               String     @id @default(uuid()) @db.Uuid
  employeeNo       String     @unique
  name             String
  departmentId     String?    @db.Uuid
  position         String?
  phone            String?
  status           UserStatus @default(ACTIVE)
  /// PC 后台登录用户名（可空：纯小程序用户无需 PC 账号）
  username         String?    @unique
  passwordHash     String?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?  @db.Timestamptz(3)
  /// 直属主管，用于审核路由
  supervisorId     String?    @db.Uuid
  disabledAt       DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  department   Department?  @relation(fields: [departmentId], references: [id])
  supervisor   User?        @relation("UserSupervisor", fields: [supervisorId], references: [id])
  subordinates User[]       @relation("UserSupervisor")
  roles        UserRole[]
  wechat       WechatIdentity[]
  bindCodes    WechatBindCode[] @relation("BindCodeUser")
  sessions     AuthSession[]

  assignedTasks     QcTask[]            @relation("TaskAssignee")
  reviewerTasks     QcTask[]            @relation("TaskReviewer")
  createdTasks      QcTask[]            @relation("TaskCreator")
  supervisedTasks   QcTask[]            @relation("TaskSupervisor")
  assignmentActions QcTaskAssignmentEvent[] @relation("AssignmentActor")
  assignmentFrom    QcTaskAssignmentEvent[] @relation("AssignmentFrom")
  assignmentTo      QcTaskAssignmentEvent[] @relation("AssignmentTo")
  confirmedDeliveries QcTaskDelivery[] @relation("DeliveryConfirmer")
  remindersSent QcReviewReminder[] @relation("ReminderRequester")
  remindersReceived QcReviewReminder[] @relation("ReminderSupervisor")
  inspections       RollInspection[]
  reviews           QcReview[]
  reviewAssignments ReviewAssignment[]
  notifications     Notification[]
  subscriptions     WechatSubscription[]
  media             MediaAsset[]

  @@index([departmentId])
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        RoleCode @unique
  name        String
  description String?

  userRoles UserRole[]

  @@map("roles")
}

/// 用户角色。departmentId 为空表示全厂范围；否则角色权限限定在该部门。
model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  departmentId String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([userId, roleId, departmentId])
  @@index([roleId])
  @@map("user_roles")
}

model WechatIdentity {
  id          String    @id @default(uuid()) @db.Uuid
  appId       String
  openId      String
  unionId     String?
  userId      String    @db.Uuid
  boundAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastLoginAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, openId])
  @@unique([appId, userId])
  @@map("wechat_identities")
}

model WechatBindCode {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  /// SHA-256(绑定码 + pepper)，不保存明文
  codeHash       String    @unique
  expiresAt      DateTime  @db.Timestamptz(3)
  usedAt         DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  failedAttempts Int       @default(0)
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation("BindCodeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wechat_bind_codes")
}

model AuthSession {
  id                       String     @id @default(uuid()) @db.Uuid
  userId                   String     @db.Uuid
  clientType               ClientType
  refreshTokenHash         String     @unique
  /// 上一个刷新令牌哈希，用于检测重放
  previousRefreshTokenHash String?    @unique
  expiresAt                DateTime   @db.Timestamptz(3)
  revokedAt                DateTime?  @db.Timestamptz(3)
  revokeReason             String?
  lastUsedAt               DateTime?  @db.Timestamptz(3)
  ip                       String?
  userAgent                String?
  createdAt                DateTime   @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

// ============ 基础资料 ============

model Customer {
  vcansOrders VcansOrder[] @relation("VcansOrderCustomer")
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  contactName  String?
  contactPhone String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  fabrics   Fabric[]
  standards QualityStandard[]
  orders    CustomerOrder[]
  tasks     QcTask[]

  @@map("customers")
}

/// 【预留】客户订单。V0.1 不提供界面，仅保证布卷可关联订单明细。
model CustomerOrder {
  id         String    @id @default(uuid()) @db.Uuid
  orderNo    String    @unique
  customerId String    @db.Uuid
  orderDate  DateTime? @db.Date
  notes      String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  customer Customer            @relation(fields: [customerId], references: [id])
  lines    CustomerOrderLine[]

  @@map("customer_orders")
}

/// 【预留】订单明细
model CustomerOrderLine {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  lineNo    Int
  fabricId  String   @db.Uuid
  quantityM Decimal? @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  order  CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fabric Fabric        @relation(fields: [fabricId], references: [id])
  rolls  FabricRoll[]

  @@unique([orderId, lineNo])
  @@map("customer_order_lines")
}

model Fabric {
  purpose DataPurpose @default(UNKNOWN)
  id                         String   @id @default(uuid()) @db.Uuid
  /// 面料货号
  code                       String   @unique
  nameZh                     String
  nameEn                     String?
  composition                String?
  widthCm                    Decimal? @db.Decimal(8, 2)
  cuttableWidthCm            Decimal? @db.Decimal(8, 2)
  gsm                        Decimal? @db.Decimal(8, 2)
  weaveStructure             String?
  coatingType                String?
  color                      String?
  colorCode                  String?
  customerId                 String?  @db.Uuid
  defaultFourPointStandardId String?  @db.Uuid
  defaultCustomerStandardId  String?  @db.Uuid
  defaultTemplateId          String?  @db.Uuid
  notes                      String?
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  customer                 Customer?           @relation(fields: [customerId], references: [id])
  defaultFourPointStandard QualityStandard?    @relation("FabricDefaultFourPoint", fields: [defaultFourPointStandardId], references: [id])
  defaultCustomerStandard  QualityStandard?    @relation("FabricDefaultCustomer", fields: [defaultCustomerStandardId], references: [id])
  defaultTemplate          InspectionTemplate? @relation(fields: [defaultTemplateId], references: [id])
  lots                     ProductionLot[]
  rolls                    FabricRoll[]
  orderLines               CustomerOrderLine[]

  @@index([customerId])
  @@map("fabrics")
}

model ProductionLot {
  id         String    @id @default(uuid()) @db.Uuid
  fabricId   String    @db.Uuid
  /// 生产批号
  lotNo      String
  /// 缸号（无则为空字符串，便于唯一约束）
  dyeLotNo   String    @default("")
  colorCode  String?
  producedAt DateTime? @db.Date
  notes      String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  fabric Fabric       @relation(fields: [fabricId], references: [id])
  rolls  FabricRoll[]

  @@unique([fabricId, lotNo, dyeLotNo])
  @@map("production_lots")
}

model FabricRoll {
  vcansOrderRoll VcansOrderRoll?
  id             String     @id @default(uuid()) @db.Uuid
  rollNo         String     @unique
  /// 二维码标识（10 位 Crockford Base32）
  qrCode         String     @unique
  fabricId       String?    @db.Uuid
  lotId          String?    @db.Uuid
  dyeLotNo       String?
  colorCode      String?
  nominalLengthM Decimal?   @db.Decimal(10, 2)
  actualLengthM  Decimal?   @db.Decimal(10, 2)
  status         RollStatus @default(PENDING)
  /// 【预留】订单明细关联
  orderLineId    String?    @db.Uuid
  notes          String?
  createdById    String?    @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  fabric      Fabric?            @relation(fields: [fabricId], references: [id])
  lot         ProductionLot?     @relation(fields: [lotId], references: [id])
  orderLine   CustomerOrderLine? @relation(fields: [orderLineId], references: [id])
  taskRolls   QcTaskRoll[]
  inspections RollInspection[]
  deliveryItems QcTaskDeliveryItem[]

  @@index([fabricId])
  @@index([lotId])
  @@index([status])
  @@map("fabric_rolls")
}

// ============ 质量标准与模板 ============

model QualityStandard {
  vcansCustomerOrders VcansOrder[] @relation("VcansCustomerStandard")
  vcansOrders VcansOrder[] @relation("VcansFourPointStandard")
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  kind        StandardKind
  customerId  String?      @db.Uuid
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  customer        Customer?         @relation(fields: [customerId], references: [id])
  versions        StandardVersion[]
  fabricsFourPt   Fabric[]          @relation("FabricDefaultFourPoint")
  fabricsCustomer Fabric[]          @relation("FabricDefaultCustomer")
  tasksFourPt     QcTask[]          @relation("TaskFourPointStandard")
  tasksCustomer   QcTask[]          @relation("TaskCustomerStandard")

  @@map("quality_standards")
}

/// 标准版本：发布后 rules 不可修改，只能新建版本
model StandardVersion {
  vcansFactoryVersions VcansOrder[] @relation("VcansFrozenFactoryVersion")
  vcansCustomerVersions VcansOrder[] @relation("VcansFrozenCustomerVersion")
  purpose DataPurpose @default(UNKNOWN)
  id            String                @id @default(uuid()) @db.Uuid
  standardId    String                @db.Uuid
  version       Int
  status        StandardVersionStatus @default(DRAFT)
  rules         Json
  notes         String?
  /// 开发默认值标记：未经工厂批准，不能作为正式验收依据
  isDevDefault  Boolean               @default(false)
  createdById   String?               @db.Uuid
  publishedById String?               @db.Uuid
  publishedAt   DateTime?             @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)

  standard          QualityStandard  @relation(fields: [standardId], references: [id])
  fourPointInspects RollInspection[] @relation("InspectionFourPointVersion")
  customerInspects  RollInspection[] @relation("InspectionCustomerVersion")

  @@unique([standardId, version])
  @@unique([id, standardId])
  @@index([standardId, status])
  @@map("standard_versions")
}

model InspectionTemplate {
  purpose DataPurpose @default(UNKNOWN)
  vcansOrders VcansOrder[] @relation("VcansTemplate")
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  content     Json
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  fabrics Fabric[]
  tasks   QcTask[]

  @@map("inspection_templates")
}

model DefectType {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique
  nameZh          String
  nameEn          String?
  category        String?
  defaultSeverity DefectSeverity @default(MINOR)
  sortOrder       Int            @default(100)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@map("defect_types")
}

// ============ 任务与检验 ============

model QcTask {
  purpose DataPurpose @default(UNKNOWN)
  vcansOrder VcansOrder?
  id                  String           @id @default(uuid()) @db.Uuid
  taskNo              String           @unique
  title               String
  departmentId        String?          @db.Uuid
  origin              TaskOrigin       @default(LEGACY)
  businessDepartmentId String?         @db.Uuid
  supervisorId        String?          @db.Uuid
  plannedRollCount    Int?
  customerId          String?          @db.Uuid
  assigneeId          String?          @db.Uuid
  reviewerId          String?          @db.Uuid
  defaultMode         InspectionMode?
  defaultScope        InspectionScope  @default(FULL)
  fourPointStandardId String           @db.Uuid
  customerStandardId  String?          @db.Uuid
  templateId          String           @db.Uuid
  status              TaskStatus       @default(OPEN)
  dueAt               DateTime?        @db.Timestamptz(3)
  notes               String?
  createdById         String           @db.Uuid
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  department        Department?        @relation(fields: [departmentId], references: [id])
  businessDepartment Department?       @relation("TaskBusinessDepartment", fields: [businessDepartmentId], references: [id], onDelete: Restrict)
  supervisor        User?              @relation("TaskSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  customer          Customer?          @relation(fields: [customerId], references: [id])
  assignee          User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  reviewer          User?              @relation("TaskReviewer", fields: [reviewerId], references: [id])
  createdBy         User               @relation("TaskCreator", fields: [createdById], references: [id])
  fourPointStandard QualityStandard    @relation("TaskFourPointStandard", fields: [fourPointStandardId], references: [id])
  customerStandard  QualityStandard?   @relation("TaskCustomerStandard", fields: [customerStandardId], references: [id])
  template          InspectionTemplate @relation(fields: [templateId], references: [id])
  rolls             QcTaskRoll[]
  inspections       RollInspection[]
  assignmentEvents  QcTaskAssignmentEvent[]
  delivery          QcTaskDelivery?
  reminders         QcReviewReminder[]

  @@index([businessDepartmentId, status])
  @@index([supervisorId, status])
  @@index([assigneeId, status])
  @@index([status])
  @@map("qc_tasks")
}

model QcTaskRoll {
  vcansOrderRoll VcansOrderRoll?
  id        String         @id @default(uuid()) @db.Uuid
  taskId    String         @db.Uuid
  rollId    String         @db.Uuid
  status    TaskRollStatus @default(PENDING)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  task        QcTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  roll        FabricRoll       @relation(fields: [rollId], references: [id])
  inspections RollInspection[]
  deliveryItems QcTaskDeliveryItem[]

  @@unique([taskId, rollId])
  @@index([rollId])
  @@map("qc_task_rolls")
}

/// 布卷检验记录。提交后锁定；退回后可修改并以新修订号重新提交；审核完成后不可修改。
model RollInspection {
  vcansSelection VcansSampleSelection? @relation("VcansSelectionInspection")
  vcansBasisSelections VcansSampleSelection[] @relation("VcansBasisInspection")
  id                   String           @id @default(uuid()) @db.Uuid
  inspectionNo         String           @unique
  taskId               String           @db.Uuid
  taskRollId           String           @db.Uuid
  rollId               String           @db.Uuid
  inspectorId          String           @db.Uuid
  mode                 InspectionMode
  scope                InspectionScope
  status               InspectionStatus @default(DRAFT)
  /// 提交修订号：每次（重新）提交 +1
  revision             Int              @default(0)
  /// 草稿乐观锁版本：每次同步 +1
  draftVersion         Int              @default(0)
  /// 复验时指向上一条检验记录
  previousInspectionId String?          @unique @db.Uuid
  fourPointVersionId   String           @db.Uuid
  customerVersionId    String?          @db.Uuid
  /// 标准快照 { fourPoint: {versionId,name,rules}, customer: {...}|null }
  standardSnapshot     Json
  templateSnapshot     Json
  /// 面料/布卷规格快照
  specSnapshot         Json
  checklistResults     Json             @default("[]")
  resultSnapshot       Json?
  fourPointResult      JudgeResult?
  customerResult       JudgeResult?
  overallResult        JudgeResult?
  totalPoints          Decimal?         @db.Decimal(10, 3)
  normalizedPoints     Decimal?         @db.Decimal(10, 2)
  inspectedLengthM     Decimal?         @db.Decimal(10, 3)
  actualLengthM        Decimal?         @db.Decimal(10, 2)
  widthUsedCm          Decimal?         @db.Decimal(8, 3)
  remarks              String?
  startedAt            DateTime         @default(now()) @db.Timestamptz(3)
  submittedAt          DateTime?        @db.Timestamptz(3)
  decidedAt            DateTime?        @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  task               QcTask              @relation(fields: [taskId], references: [id])
  taskRoll           QcTaskRoll          @relation(fields: [taskRollId], references: [id])
  roll               FabricRoll          @relation(fields: [rollId], references: [id])
  inspector          User                @relation(fields: [inspectorId], references: [id])
  previous           RollInspection?     @relation("InspectionChain", fields: [previousInspectionId], references: [id])
  next               RollInspection?     @relation("InspectionChain")
  fourPointVersion   StandardVersion     @relation("InspectionFourPointVersion", fields: [fourPointVersionId], references: [id])
  customerVersion    StandardVersion?    @relation("InspectionCustomerVersion", fields: [customerVersionId], references: [id])
  segments           InspectionSegment[]
  measurements       Measurement[]
  defects            Defect[]
  mediaLinks         MediaLink[]
  revisions          InspectionRevision[]
  reviews            QcReview[]
  reviewAssignments  ReviewAssignment[]
  deliveryItems QcTaskDeliveryItem[]

  @@index([rollId])
  @@index([taskRollId])
  @@index([inspectorId, status])
  @@index([status, submittedAt])
  @@map("roll_inspections")
}

/// 每次提交的完整不可变快照（质检记录版本）
model InspectionRevision {
  vcansBasisSelections VcansSampleSelection[] @relation("VcansBasisRevision")
  id             String   @id @default(uuid()) @db.Uuid
  inspectionId   String   @db.Uuid
  revision       Int
  snapshot       Json
  idempotencyKey String   @unique
  submittedById  String   @db.Uuid
  submittedAt    DateTime @default(now()) @db.Timestamptz(3)

  inspection RollInspection @relation(fields: [inspectionId], references: [id])
  deliveryItems QcTaskDeliveryItem[]

  @@unique([inspectionId, revision])
  @@map("inspection_revisions")
}

model InspectionSegment {
  id           String  @id @default(uuid()) @db.Uuid
  inspectionId String  @db.Uuid
  seq          Int
  startM       Decimal @db.Decimal(10, 3)
  endM         Decimal @db.Decimal(10, 3)

  inspection RollInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, seq])
  @@map("inspection_segments")
}

model Measurement {
  id           String   @id @default(uuid()) @db.Uuid
  inspectionId String   @db.Uuid
  itemKey      String
  seq          Int
  value        Decimal  @db.Decimal(12, 3)
  unit         String
  positionM    Decimal? @db.Decimal(10, 3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  inspection RollInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, itemKey, seq])
  @@map("measurements")
}

model Defect {
  id              String         @id @default(uuid()) @db.Uuid
  inspectionId    String         @db.Uuid
  /// 客户端生成的 UUID，用于离线同步幂等
  clientId        String         @db.Uuid
  defectTypeCode  String
  lengthCm        Decimal        @db.Decimal(10, 2)
  widthCm         Decimal?       @db.Decimal(10, 2)
  positionM       Decimal        @db.Decimal(10, 3)
  widthPositionCm Decimal?       @db.Decimal(10, 2)
  severity        DefectSeverity
  /// 引擎计算扣分（封顶前）
  points          Decimal?       @db.Decimal(8, 2)
  remark          String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  inspection RollInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, clientId])
  @@index([defectTypeCode])
  @@map("defects")
}

// ============ 媒体 ============

model MediaAsset {
  id           String      @id @default(uuid()) @db.Uuid
  provider     String
  bucket       String
  objectKey    String      @unique
  thumbKey     String?     @unique
  mimeType     String
  sizeBytes    Int?
  status       MediaStatus @default(PENDING)
  /// 上传意图所属检验（对象键前缀依据）
  inspectionId String?     @db.Uuid
  uploadedById String      @db.Uuid
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  confirmedAt  DateTime?   @db.Timestamptz(3)

  uploadedBy User        @relation(fields: [uploadedById], references: [id])
  links      MediaLink[]

  @@index([inspectionId])
  @@map("media_assets")
}

model MediaLink {
  id             String    @id @default(uuid()) @db.Uuid
  mediaId        String    @db.Uuid
  inspectionId   String    @db.Uuid
  kind           MediaKind
  checkpointKey  String?
  defectClientId String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  media      MediaAsset     @relation(fields: [mediaId], references: [id])
  inspection RollInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([mediaId, inspectionId])
  @@index([inspectionId])
  @@map("media_links")
}

// ============ 审核 ============

model QcReview {
  finalResult JudgeResult?
  finalReason String?
  id           String         @id @default(uuid()) @db.Uuid
  inspectionId String         @db.Uuid
  revision     Int
  reviewerId   String         @db.Uuid
  decision     ReviewDecision
  comment      String?
  /// 系统判定不合格但审核通过（让步接收）
  isConcession Boolean        @default(false)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  inspection RollInspection @relation(fields: [inspectionId], references: [id])
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  deliveryItems QcTaskDeliveryItem[]

  /// 同一修订只能有一个审核结论
  @@unique([inspectionId, revision])
  @@map("qc_reviews")
}

model ReviewAssignment {
  id           String           @id @default(uuid()) @db.Uuid
  inspectionId String           @db.Uuid
  revision     Int
  assigneeId   String           @db.Uuid
  status       AssignmentStatus @default(PENDING)
  reviewId     String?          @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  completedAt  DateTime?        @db.Timestamptz(3)

  inspection RollInspection @relation(fields: [inspectionId], references: [id])
  assignee   User           @relation(fields: [assigneeId], references: [id])

  @@unique([inspectionId, revision, assigneeId])
  @@index([assigneeId, status])
  @@map("review_assignments")
}


/// 派发历史：由服务在修改执行人的同一事务内追加。
model QcTaskAssignmentEvent {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  actorId String @db.Uuid
  fromAssigneeId String? @db.Uuid
  toAssigneeId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  reason String?
  task QcTask @relation(fields: [taskId], references: [id])
  actor User @relation("AssignmentActor", fields: [actorId], references: [id])
  fromAssignee User? @relation("AssignmentFrom", fields: [fromAssigneeId], references: [id])
  toAssignee User @relation("AssignmentTo", fields: [toAssigneeId], references: [id])
  @@index([taskId, createdAt])
  @@map("qc_task_assignment_events")
}

/// 新业务任务的整单交付版本；业务逻辑负责事务检查与冻结。
model QcTaskDelivery {
  id String @id @default(uuid()) @db.Uuid
  taskId String @unique @db.Uuid
  confirmedById String @db.Uuid
  confirmedAt DateTime @default(now()) @db.Timestamptz(3)
  plannedRollCount Int
  snapshotVersion Int @default(1)
  snapshot Json
  task QcTask @relation(fields: [taskId], references: [id])
  confirmedBy User @relation("DeliveryConfirmer", fields: [confirmedById], references: [id])
  items QcTaskDeliveryItem[]
  @@map("qc_task_deliveries")
}

model QcTaskDeliveryItem {
  id String @id @default(uuid()) @db.Uuid
  deliveryId String @db.Uuid
  taskRollId String @db.Uuid
  rollId String @db.Uuid
  inspectionId String @db.Uuid
  revision Int
  inspectionRevisionId String @db.Uuid
  reviewId String @db.Uuid
  snapshot Json
  delivery QcTaskDelivery @relation(fields: [deliveryId], references: [id])
  taskRoll QcTaskRoll @relation(fields: [taskRollId], references: [id])
  roll FabricRoll @relation(fields: [rollId], references: [id])
  inspection RollInspection @relation(fields: [inspectionId], references: [id])
  inspectionRevision InspectionRevision @relation(fields: [inspectionRevisionId], references: [id])
  review QcReview @relation(fields: [reviewId], references: [id])
  @@unique([deliveryId, taskRollId])
  @@unique([deliveryId, rollId])
  @@map("qc_task_delivery_items")
}

/// 同一任务滚动限频由服务事务锁与最近记录共同执行。
model QcReviewReminder {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  requesterId String @db.Uuid
  supervisorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  dedupeKey String @unique
  notificationId String? @db.Uuid
  task QcTask @relation(fields: [taskId], references: [id])
  requester User @relation("ReminderRequester", fields: [requesterId], references: [id])
  supervisor User @relation("ReminderSupervisor", fields: [supervisorId], references: [id])
  notification Notification? @relation(fields: [notificationId], references: [id])
  @@index([taskId, createdAt])
  @@map("qc_review_reminders")
}

// ============ 通知 ============

/// 站内通知 / 待办
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  /// 小程序页面路径
  pagePath   String?
  readAt     DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders QcReviewReminder[]

  @@index([userId, readAt])
  @@map("notifications")
}

/// Transactional Outbox：与业务数据同事务写入，由调度器投递到 BullMQ
model NotificationOutbox {
  id          String       @id @default(uuid()) @db.Uuid
  eventType   String
  payload     Json
  dedupeKey   String       @unique
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime     @default(now()) @db.Timestamptz(3)
  enqueuedAt  DateTime?    @db.Timestamptz(3)
  processedAt DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@index([status, availableAt])
  @@map("notification_outbox")
}

model NotificationDelivery {
  id           String              @id @default(uuid()) @db.Uuid
  outboxId     String              @db.Uuid
  userId       String              @db.Uuid
  channel      NotificationChannel
  status       DeliveryStatus
  templateId   String?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  outbox NotificationOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([outboxId])
  @@index([userId])
  @@map("notification_deliveries")
}

/// 微信一次性订阅消息授权余量（用户每次点"允许"+1，每次发送 -1）
model WechatSubscription {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  templateId     String
  remaining      Int       @default(0)
  lastAcceptedAt DateTime? @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@map("wechat_subscriptions")
}

// ============ 审计与设置 ============

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("system_settings")
}

// VCANS订单及报告增量模型（旧业务模型不回填）
enum VcansOrderSource {
  MANUAL
  VCANS
}
enum VcansPlanMode {
  FULL
  FIXED_PER_LOT
  PERCENT_PER_LOT
}
enum VcansSelectionKind {
  ORIGINAL
  ADDITIONAL
}
enum VcansImportStatus {
  PREVIEW
  COMMITTED
  EXPIRED
}
model VcansOrder {
  requiredStandardMode RequiredStandardMode?
  factoryVersionId String? @db.Uuid
  customerVersionId String? @db.Uuid
  frozenRuleSource VcansRuleSource?
  frozenTemplateSnapshot Json?
  frozenTemplateVersion Int?
  factoryVersion StandardVersion? @relation("VcansFrozenFactoryVersion", fields: [factoryVersionId, fourPointStandardId], references: [id, standardId], onDelete: Restrict)
  customerVersion StandardVersion? @relation("VcansFrozenCustomerVersion", fields: [customerVersionId, customerStandardId], references: [id, standardId], onDelete: Restrict)
  customerId String? @db.Uuid
  customer Customer? @relation("VcansOrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  customerStandardId String? @db.Uuid
  customerStandard QualityStandard? @relation("VcansCustomerStandard", fields: [customerStandardId], references: [id], onDelete: Restrict)
  purpose DataPurpose @default(UNKNOWN)
  supervisorId String? @db.Uuid
  assignedInspectorId String? @db.Uuid
  fourPointStandardId String? @db.Uuid
  templateId String? @db.Uuid
  supervisor User? @relation("VcansSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  assignedInspector User? @relation("VcansInspector", fields: [assignedInspectorId], references: [id], onDelete: Restrict)
  fourPointStandard QualityStandard? @relation("VcansFourPointStandard", fields: [fourPointStandardId], references: [id], onDelete: Restrict)
  template InspectionTemplate? @relation("VcansTemplate", fields: [templateId], references: [id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  hNo String @unique
  businessDepartmentId String @db.Uuid
  taskId String? @unique @db.Uuid
  createdById String @db.Uuid
  source VcansOrderSource
  dueAt DateTime? @db.Timestamptz(3)
  version Int @default(0)
  arrivalComplete Boolean @default(false)
  arrivalConfirmedById String? @db.Uuid
  arrivalConfirmedAt DateTime? @db.Timestamptz(3)
  planMode VcansPlanMode
  fixedRolls Int?
  percent Decimal? @db.Decimal(7, 4)
  confirmedAt DateTime? @db.Timestamptz(3)
  confirmedById String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  businessDepartment Department @relation("VcansOrderDepartment", fields: [businessDepartmentId], references: [id], onDelete: Restrict)
  task QcTask? @relation(fields: [taskId], references: [id], onDelete: Restrict)
  createdBy User @relation("VcansOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  arrivalConfirmedBy User? @relation("VcansArrivalConfirmer", fields: [arrivalConfirmedById], references: [id], onDelete: Restrict)
  confirmedBy User? @relation("VcansOrderConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  lines VcansOrderLine[]
  changes VcansOrderChange[]
  reports VcansReportVersion[]
  additionalRequests VcansAdditionalRequest[]
  @@index([businessDepartmentId])
  @@index([customerId])
  @@map("vcans_orders")
}
model VcansOrderLine {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  lineNo Int
  customerOrderNo String?
  productName String?
  productCode String?
  color String?
  specification String?
  quantity Decimal? @db.Decimal(18, 4)
  quantityUnit String?
  sourceSnapshot Json?
  revision Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  order VcansOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lots VcansDyeLot[]
  importRows VcansImportRow[]
  changes VcansOrderChange[]
  @@unique([orderId, lineNo])
  @@unique([id, orderId])
  @@map("vcans_order_lines")
}
model VcansImportBatch {
  id String @id @default(uuid()) @db.Uuid
  businessDepartmentId String @db.Uuid
  createdById String @db.Uuid
  idempotencyKey String
  sourceHash String
  previewSummary Json?
  expiresAt DateTime? @db.Timestamptz(3)
  commitKey String?
  commitHash String?
  commitResult Json?
  status VcansImportStatus @default(PREVIEW)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  businessDepartment Department @relation("VcansImportDepartment", fields: [businessDepartmentId], references: [id], onDelete: Restrict)
  createdBy User @relation("VcansImportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rows VcansImportRow[]
  @@unique([businessDepartmentId, idempotencyKey])
  @@unique([businessDepartmentId, commitKey])
  @@map("vcans_import_batches")
}
model VcansImportRow {
  id String @id @default(uuid()) @db.Uuid
  batchId String @db.Uuid
  sourceRow Int
  sourceSheet String @default("")
  rawSnapshot Json
  validation Json?
  orderLineId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  batch VcansImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  orderLine VcansOrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  @@unique([batchId, sourceSheet, sourceRow])
  @@map("vcans_import_rows")
}
model VcansOrderChange {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  lineId String? @db.Uuid
  actorId String @db.Uuid
  targetType String
  targetId String @db.Uuid
  before Json?
  after Json?
  reason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  order VcansOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  line VcansOrderLine? @relation(fields: [lineId, orderId], references: [id, orderId], onDelete: Restrict)
  actor User @relation("VcansChangeActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
  @@map("vcans_order_changes")
}
model VcansDyeLot {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  lineId String @db.Uuid
  dyeLotNo String
  actualRollCount Int
  version Int @default(0)
  createdById String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  line VcansOrderLine @relation(fields: [lineId, orderId], references: [id, orderId], onDelete: Restrict)
  createdBy User @relation("VcansLotCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rolls VcansOrderRoll[]
  @@unique([lineId, dyeLotNo])
  @@unique([id, lineId, orderId])
  @@map("vcans_dye_lots")
}
model VcansOrderRoll {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  lineId String @db.Uuid
  lotId String @db.Uuid
  rollId String @unique @db.Uuid
  taskRollId String? @unique @db.Uuid
  nominalLengthM Decimal? @db.Decimal(10, 2)
  nominalWeightKg Decimal? @db.Decimal(10, 3)
  measuredLengthM Decimal? @db.Decimal(10, 2)
  measuredWeightKg Decimal? @db.Decimal(10, 3)
  nominalSource String?
  measuredLengthSource String?
  measuredWeightSource String?
  measuredLengthAt DateTime? @db.Timestamptz(3)
  measuredWeightAt DateTime? @db.Timestamptz(3)
  measuredLengthById String? @db.Uuid
  measuredWeightById String? @db.Uuid
  version Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  measuredLengthBy User? @relation("VcansMeasuredLengthActor", fields: [measuredLengthById], references: [id], onDelete: Restrict)
  measuredWeightBy User? @relation("VcansMeasuredWeightActor", fields: [measuredWeightById], references: [id], onDelete: Restrict)
  lot VcansDyeLot @relation(fields: [lotId, lineId, orderId], references: [id, lineId, orderId], onDelete: Restrict)
  roll FabricRoll @relation(fields: [rollId], references: [id], onDelete: Restrict)
  taskRoll QcTaskRoll? @relation(fields: [taskRollId], references: [id], onDelete: Restrict)
  selections VcansSampleSelection[]
  @@unique([id, lotId, orderId])
  @@map("vcans_order_rolls")
}
model VcansSampleSelection {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  lotId String @db.Uuid
  orderRollId String @db.Uuid
  kind VcansSelectionKind
  selectedById String @db.Uuid
  reason String?
  requestId String? @db.Uuid
  inspectionId String? @unique @db.Uuid
  basisInspectionId String? @db.Uuid
  basisRevisionId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  orderRoll VcansOrderRoll @relation(fields: [orderRollId, lotId, orderId], references: [id, lotId, orderId], onDelete: Restrict)
  selectedBy User @relation("VcansSampleSelector", fields: [selectedById], references: [id], onDelete: Restrict)
  request VcansAdditionalRequest? @relation(fields: [requestId, orderId], references: [id, orderId], onDelete: Restrict)
  inspection RollInspection? @relation("VcansSelectionInspection", fields: [inspectionId], references: [id], onDelete: Restrict)
  basisInspection RollInspection? @relation("VcansBasisInspection", fields: [basisInspectionId], references: [id], onDelete: Restrict)
  basisRevision InspectionRevision? @relation("VcansBasisRevision", fields: [basisRevisionId], references: [id], onDelete: Restrict)
  @@unique([requestId, orderRollId])
  @@index([orderRollId, kind])
  @@map("vcans_sample_selections")
}
model VcansReportVersion {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  version Int
  confirmedById String @db.Uuid
  confirmedAt DateTime @db.Timestamptz(3)
  snapshot Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  order VcansOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  confirmedBy User @relation("VcansReportConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  files VcansReportFile[]
  @@unique([orderId, version])
  @@map("vcans_report_versions")
}
model VcansReportFile {
  id String @id @default(uuid()) @db.Uuid
  reportVersionId String @db.Uuid
  outputType String
  objectKey String
  sha256 String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  reportVersion VcansReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Restrict)
  @@unique([reportVersionId, outputType])
  @@unique([objectKey])
  @@map("vcans_report_files")
}

model VcansAdditionalRequest {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  requestKey String
  requestHash String
  result Json?
  actorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  order VcansOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor User @relation("VcansAdditionalActor", fields: [actorId], references: [id], onDelete: Restrict)
  selections VcansSampleSelection[]
  @@unique([orderId, requestKey])
  @@unique([id, orderId])
  @@map("vcans_additional_requests")
}

// 业务数据用途：历史未知不自动推断
enum DataPurpose {
  UNKNOWN
  TEST
  FORMAL
}

enum VcansRuleSource {
  FACTORY
  CUSTOMER
}

enum RequiredStandardMode {
  FACTORY
  CUSTOMER_REQUIRED
}
