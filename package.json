{
  "name": "fabricqc",
  "version": "0.1.0",
  "private": true,
  "description": "FabricQC Lite — 面料工厂智能验布管理系统",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm build:packages && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:infra": "docker compose -f deploy/docker-compose.dev.yml --env-file .env up -d",
    "dev:infra:down": "docker compose -f deploy/docker-compose.dev.yml --env-file .env down",
    "dev:api": "pnpm --filter @fabricqc/api dev",
    "dev:admin": "pnpm --filter @fabricqc/admin dev",
    "dev:miniapp": "pnpm --filter @fabricqc/miniapp dev:weapp",
    "db:migrate": "pnpm --filter @fabricqc/api prisma:migrate",
    "db:seed": "pnpm --filter @fabricqc/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}
